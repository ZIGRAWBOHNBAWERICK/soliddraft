#!/usr/bin/env bash
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
if [[ $# -eq 0 ]]; then
  git -C "$root" config --local core.hooksPath ci/hooks
  echo "Installed the pre-push lint hook. Run ci/run lint to check now."
  exit 0
fi
if [[ ( $# -ne 2 && $# -ne 3 ) || "$1" != --tools ]]; then
  echo "Usage: ci/bootstrap [--tools PREFIX [TOOL]]" >&2
  exit 2
fi
python3 "$root/ci/install-tool.py" "$root" "$2" "${3:-cargo-nextest}"
