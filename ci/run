#!/usr/bin/env bash
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"

export CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0

case "${1:-}" in
  lint)
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --all-features -- -D warnings
    python3 -m unittest discover -s ci -p 'test_*.py'
    ;;
  test-build)
    [[ $# -eq 2 || $# -eq 3 ]]
    export CARGO_PROFILE_TEST_OPT_LEVEL=2
    selection=()
    if [[ $# -eq 3 ]]; then selection=(--selection "$3"); fi
    python3 ci/run-selected.py test-build "$2" "${selection[@]}"
    ;;
  test-doc)
    export CARGO_PROFILE_TEST_OPT_LEVEL=2
    [[ $# -eq 1 || $# -eq 2 ]]
    selection=()
    if [[ $# -eq 2 ]]; then selection=(--selection "$2"); fi
    python3 ci/run-selected.py test-doc "${selection[@]}"
    ;;
  test-shard)
    [[ $# -eq 3 ]]
    python3 ci/balance.py run "$2" "$3"
    ;;
  *)
    echo "Usage: ci/run lint | test-build ARCHIVE [SELECTION] | test-doc [SELECTION] | test-shard ARCHIVE K/N" >&2
    exit 2
    ;;
esac
