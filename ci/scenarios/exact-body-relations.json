      ]
    },
    {
      "tool": "assembly_check_clearance",
      "arguments": {
        "clearance": "0 mm"
      },
      "checks": [
        {
          "pointer": "/result/report/below",
          "equals": 1
        },
        {
          "pointer": "/result/report/undecided",
          "equals": 0
        }
      ]
    },
    {
      "tool": "assembly_check_clearance",
      "arguments": {
        "clearance": "-1 mm"
      },
      "refused": "invalid",
      "checks": [
        {
          "pointer": "/result/refused",
          "equals": "invalid"
        },
        {
          "pointer": "/result/message",
          "equals": "a clearance is a length of zero or more"
        }
      ]
    }
  ]
