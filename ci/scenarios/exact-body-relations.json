{
  "format": "soliddraft-scenario/1",
  "name": "exact-body-relations",
  "folders": [
    "work"
  ],
  "max_work": 20000000,
  "steps": [
    {
      "tool": "sketch",
      "arguments": {
        "plane": "top",
        "shapes": [
          {
            "shape": "rectangle",
            "center": [
              0,
              0,
              0
            ],
            "width": 40,
            "height": 30
          }
        ]
      },
      "checks": []
    },
    {
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch1",
        "depth": 10,
        "flip": false
      },
      "checks": []
    },
    {
      "tool": "save",
      "arguments": {
        "path": "{bundle}/work/a.dwprt"
      },
      "checks": [],
      "files": [
        "{bundle}/work/a.dwprt"
      ],
      "inspect": {
        "info": [
          "doc",
          "info",
          "{bundle}/work/a.dwprt",
          "--json"
        ]
      }
    },
    {
      "tool": "make_assembly",
      "arguments": {},
      "checks": [
        {
          "pointer": "/summary/assembly/components/0/path",
          "equals": "2"
        }
      ]
    },
    {
      "tool": "assembly_save",
