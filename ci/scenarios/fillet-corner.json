{
  "format": "soliddraft-scenario/1",
  "name": "fillet-corner",
  "steps": [
    {
      "tool": "sketch",
      "arguments": {
        "plane": "top",
        "shapes": [
          {
            "shape": "rectangle",
            "center": [
              20,
              15,
              0
            ],
            "width": 40,
            "height": 30
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch1",
        "depth": 10,
        "flip": false
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 12000,
          "tolerance": 0.005
        }
      ]
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 7",
          "Boss-Extrude1 \u00b7 Edge 6"
        ],
        "radius": 2
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11940.678448,
          "tolerance": 0.005
        }
      ],
      "label": "two fillets meeting at a corner whose third edge stays sharp build, with no corner choice asked"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 3
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11867.389342,
          "tolerance": 0.005
        }
      ],
      "label": "an R3 edit closes the corner the same way"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 0
      },
      "refused": "radius must be greater than 0",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11867.389342,
          "tolerance": 0.005
        }
      ],
      "label": "a zero radius is refused and leaves the R3 fillet"
    },
    {
      "tool": "feature",
      "arguments": {
        "name": "Fillet1"
      },
      "checks": [
        {
          "pointer": "/result/radius",
          "equals": 3
        },
        {
          "pointer": "/result/picked_edges/1",
          "equals": "Boss-Extrude1 \u00b7 End cap \u2229 Boss-Extrude1 \u00b7 Side of line 2"
        }
      ],
      "label": "the fillet holds its edges and radius only"
    }
  ]
}
