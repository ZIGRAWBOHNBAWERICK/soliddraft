{
  "format": "soliddraft-scenario/1",
  "name": "fillet-overflow",
  "steps": [
    {
      "tool": "sketch",
      "arguments": {
        "plane": "top",
        "shapes": [
          {
            "shape": "rectangle",
            "center": [
              20,
              15,
              0
            ],
            "width": 40,
            "height": 30
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch1",
        "depth": 10,
        "flip": false
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 12000,
          "tolerance": 0.005
        }
      ]
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 7"
        ],
        "radius": 2,
        "overflow": "roll_over"
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "explicit roll-over builds the default fillet"
    },
    {
      "tool": "feature",
      "arguments": {
        "name": "Fillet1"
      },
      "checks": [
        {
          "pointer": "/result/overflow",
          "equals": "roll_over"
        },
        {
          "pointer": "/result/picked_edges/0",
          "equals": "Boss-Extrude1 \u00b7 End cap \u2229 Boss-Extrude1 \u00b7 Side of line 3"
        }
      ],
      "label": "the fillet keeps its policy"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 3,
        "overflow": {
          "keep_neighbours": [
            {
              "edge": "Boss-Extrude1 \u00b7 End cap \u2229 Boss-Extrude1 \u00b7 Side of line 3",
              "at": "Boss-Extrude1 \u00b7 Side of line 2",
              "setback": 5
            }
          ]
        }
      },
      "refused": "coming soon",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "keeping neighbours is refused until Catallax builds it"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 3
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11922.743339,
          "tolerance": 0.005
        }
      ],
      "label": "the radius edit keeps roll-over"
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 5"
        ],
        "radius": 2,
        "overflow": {
          "keep_neighbours": [
            {
              "edge": "Boss-Extrude1 \u00b7 Edge 7",
              "at": "Boss-Extrude1 \u00b7 Side of line 2",
              "setback": 5
            }
          ]
        }
      },
      "refused": "is not one of the fillet's edges",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11922.743339,
          "tolerance": 0.005
        }
      ],
      "label": "a station names one of the fillet's own edges"
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 5"
        ],
        "radius": 2,
        "overflow": {
          "keep_neighbours": [
            {
              "edge": "Boss-Extrude1 \u00b7 Edge 5",
              "at": "Boss-Extrude1 \u00b7 Side of line 2",
              "setback": 5
            }
          ]
        }
      },
      "refused": "coming soon",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11922.743339,
          "tolerance": 0.005
        }
      ],
      "label": "a new fillet that keeps its neighbours is refused too"
    },
    {
      "tool": "feature",
      "arguments": {
        "name": "Fillet1"
      },
      "checks": [
        {
          "pointer": "/result/overflow",
          "equals": "roll_over"
        },
        {
          "pointer": "/result/radius",
          "equals": 3
        }
      ],
      "label": "the refusals left the part as it was"
    }
  ]
}
