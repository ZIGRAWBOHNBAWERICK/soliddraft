{
  "format": "soliddraft-scenario/1",
  "name": "fillet-variable",
  "steps": [
    {
      "tool": "sketch",
      "arguments": {
        "plane": "top",
        "shapes": [
          {
            "shape": "rectangle",
            "center": [
              20,
              15,
              0
            ],
            "width": 40,
            "height": 30
          }
        ]
      }
    },
    {
      "tool": "extrude",
      "arguments": {
        "sketch": "Sketch1",
        "depth": 10,
        "flip": false
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 12000,
          "tolerance": 0.005
        }
      ]
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 7"
        ],
        "radius": 2
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "a constant fillet builds"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 2,
        "radius_laws": [
          {
            "edge": "Boss-Extrude1 \u00b7 End cap \u2229 Boss-Extrude1 \u00b7 Side of line 3",
            "from": "Boss-Extrude1 \u00b7 Side of line 2",
            "radius": {
              "kind": "linear",
              "start": 1,
              "end": 3
            }
          }
        ]
      },
      "refused": "coming soon",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "a linear law is refused until Catallax builds it"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 2,
        "radius_laws": [
          {
            "edge": "Boss-Extrude1 \u00b7 End cap \u2229 Boss-Extrude1 \u00b7 Side of line 3",
            "from": "Boss-Extrude1 \u00b7 Side of line 2",
            "radius": {
              "kind": "linear",
              "start": 0,
              "end": 0
            }
          }
        ]
      },
      "refused": "not both zero",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "a law that is zero at both ends is refused"
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 5"
        ],
        "radius": 2,
        "radius_laws": [
          {
            "edge": "Boss-Extrude1 \u00b7 Edge 7",
            "from": "Boss-Extrude1 \u00b7 Side of line 2",
            "radius": {
              "kind": "linear",
              "start": 1,
              "end": 3
            }
          }
        ]
      },
      "refused": "is not one of the fillet's edges",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "a law names one of the fillet's own edges"
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Boss-Extrude1 \u00b7 Edge 5"
        ],
        "radius": 2,
        "radius_laws": [
          {
            "edge": "Boss-Extrude1 \u00b7 Edge 5",
            "from": "Boss-Extrude1 \u00b7 Side of line 2",
            "radius": {
              "kind": "linear",
              "start": 0,
              "end": 4
            }
          }
        ]
      },
      "refused": "coming soon",
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11965.663706,
          "tolerance": 0.005
        }
      ],
      "label": "a new variable fillet with a collapsed end is refused too"
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 3,
        "radius_laws": []
      },
      "checks": [
        {
          "pointer": "/measurement/volume_mm3",
          "approx": 11922.743339,
          "tolerance": 0.005
        }
      ],
      "label": "an empty law list keeps the fillet constant"
    },
    {
      "tool": "feature",
      "arguments": {
        "name": "Fillet1"
      },
      "checks": [
        {
          "pointer": "/result/radius",
          "equals": 3
        },
        {
          "pointer": "/result/picked_edges/0",
          "equals": "Boss-Extrude1 \u00b7 End cap \u2229 Boss-Extrude1 \u00b7 Side of line 3"
        }
      ],
      "label": "the refusals left the part as it was"
    }
  ]
}
