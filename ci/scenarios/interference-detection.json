        "a": {
          "component": 2,
          "feature": "Boss-Extrude1",
          "generator": "end_cap"
        },
        "b": {
          "component": 4,
          "feature": "Boss-Extrude1",
          "generator": "start_cap"
        },
        "alignment": "opposed",
