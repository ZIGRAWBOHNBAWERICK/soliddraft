          "pointer": "/summary/assembly/components/1/translation/2",
          "approx": 9,
          "tolerance": 1e-09
        }
      ]
    },
    {
      "tool": "assembly_check_interference",
      "arguments": {},
      "checks": [
        {
          "pointer": "/result/report/interferes",
          "equals": 1
        },
        {
          "pointer": "/result/report/results/0/outcome",
          "equals": "interferes"
        },
        {
          "pointer": "/result/report/results/0/witness/2",
          "approx": 9.5,
          "tolerance": 0.5
        },
        {
          "pointer": "/result/report/results/0/distance/hi",
          "equals": 0
