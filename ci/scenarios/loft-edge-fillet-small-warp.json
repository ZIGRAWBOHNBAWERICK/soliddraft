        },
        {
          "pointer": "/summary/features/3/display_answer/display/method",
          "contains": "Bernstein"
        },
        {
          "pointer": "/summary/features/3/display_answer/display/method",
          "contains": "outward L1 bound for f32 screen-coordinate rounding"
