          "pointer": "/summary/edit_state/answered_within_bound",
          "equals": true
        },
        {
          "pointer": "/summary/edit_state/display_only_bound",
          "equals": true
        },
        {
          "pointer": "/summary/features/3/display_answer/display/kind",
