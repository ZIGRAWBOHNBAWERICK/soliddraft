{
  "format": "soliddraft-scenario/1",
  "name": "loft-edge-fillet",
  "max_work": 20000000,
  "steps": [
    {
      "tool": "sketch_geometry",
      "arguments": {
        "plane": "top",
        "offset": 0,
        "operations": [
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": -0.1,
                "v": -0.1
              },
              "b": {
                "u": 0.1,
                "v": -0.1
              }
            },
            "construction": false
          },
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": 0.1,
                "v": -0.1
              },
              "b": {
                "u": 0.1,
                "v": 0.1
              }
            },
            "construction": false
          },
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": 0.1,
                "v": 0.1
              },
              "b": {
                "u": -0.1,
                "v": 0.1
              }
            },
            "construction": false
          },
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": -0.1,
                "v": 0.1
              },
              "b": {
                "u": -0.1,
                "v": -0.1
              }
            },
            "construction": false
          }
        ]
      }
    },
    {
      "tool": "sketch_geometry",
      "arguments": {
        "plane": "top",
        "offset": 0.2,
        "operations": [
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": 0.0,
                "v": -0.1
              },
              "b": {
                "u": 0.1,
                "v": 0.0
              }
            },
            "construction": false
          },
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": 0.1,
                "v": 0.0
              },
              "b": {
                "u": 0.0,
                "v": 0.2
              }
            },
            "construction": false
          },
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": 0.0,
                "v": 0.2
              },
              "b": {
                "u": -0.2,
                "v": 0.0
              }
            },
            "construction": false
          },
          {
            "tool": "add",
            "kind": {
              "type": "line",
              "a": {
                "u": -0.2,
                "v": 0.0
              },
              "b": {
                "u": 0.0,
                "v": -0.1
              }
            },
            "construction": false
          }
        ]
      }
    },
    {
      "tool": "loft",
      "arguments": {
        "profiles": [
          "Sketch1",
          "Sketch2"
        ],
        "shape": "ruled"
      },
      "checks": [
        {
          "pointer": "/summary/body/faces",
          "equals": 6
        }
      ]
    },
    {
      "tool": "fillet",
      "arguments": {
        "edges": [
          "Loft1 \u00b7 Edge 1"
        ],
        "radius": 0.01
      },
      "checks": [
        {
          "pointer": "/summary/body/faces",
          "equals": 7
        },
        {
          "pointer": "/summary/features/3/name",
          "equals": "Fillet1"
        },
        {
          "pointer": "/summary/edit_state/display_ready",
          "equals": true
        },
        {
          "pointer": "/summary/edit_state/proved_revision",
          "same_as": {
            "pointer": "/summary/edit_state/requested_revision"
          }
        },
        {
          "pointer": "/summary/edit_state/displayed_revision",
          "same_as": {
            "pointer": "/summary/edit_state/requested_revision"
          }
        },
        {
          "pointer": "/summary/edit_state/answered_within_bound",
          "absent": true
        },
        {
          "pointer": "/summary/edit_state/display_only_bound",
          "absent": true
        },
        {
          "pointer": "/summary/features/3/display_answer",
          "absent": true
        },
        {
          "pointer": "/summary/features/3/status",
          "equals": "ok"
        }
      ]
    },
    {
      "tool": "edit_fillet",
      "arguments": {
        "feature": "Fillet1",
        "radius": 0
      },
      "refused": "radius must be greater than 0",
      "same_geometry_as_step": 4,
      "checks": [
        {
          "pointer": "/summary/features",
          "same_as_step": 4
        },
        {
          "pointer": "/summary/undo",
          "same_as_step": 4
        }
      ]
    },
    {
      "tool": "undo",
      "arguments": {},
      "same_geometry_as_step": 3
    },
    {
      "tool": "redo",
      "arguments": {},
      "same_geometry_as_step": 4
    },
    {
      "tool": "save",
      "arguments": {
        "path": "{bundle}/loft-fillet.dwprt"
      },
      "files": [
        "{bundle}/loft-fillet.dwprt"
      ]
    },
    {
      "tool": "open",
      "arguments": {
        "path": "{bundle}/loft-fillet.dwprt"
      },
      "fresh_process": true,
      "same_geometry_as_step": 4,
      "exports": [
        {
          "format": "step",
          "raw_valid": true,
          "checks": [
            {
              "pointer": "/report/within_tolerance",
              "equals": true
            },
            {
              "pointer": "/report/solids",
              "equals": 1
            }
          ]
        }
      ]
    }
  ]
}
