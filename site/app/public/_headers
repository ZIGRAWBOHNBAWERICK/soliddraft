/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://soliddraft-feedback.sdc-feedback-inbox.workers.dev; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
