{
  "format": "soliddraft-recipe/1",
  "name": "boss-fillet",
  "description": "The union recipe with the circular edge where the boss meets the block filleted. The edge is chosen by history: the edge the union created.",
  "steps": [
    { "id": "block_sketch", "op": "profile", "plane": "XY", "rectangle": { "center": [0, 0], "width": 40, "height": 30 } },
    { "id": "block", "op": "extrude", "profile": "block_sketch", "distance": 10 },
    { "id": "boss_sketch", "op": "profile", "plane": { "base": "XY", "origin": [10, 0, 5] }, "circle": { "center": [0, 0], "radius": 6 } },
    { "id": "boss", "op": "extrude", "profile": "boss_sketch", "distance": 20 },
    { "id": "joined", "op": "boolean", "kind": "union", "target": "block", "tool": "boss" },
    { "id": "seam", "op": "fillet", "body": "joined", "radius": 1.5, "edges": { "created_by": "joined" } }
  ],
  "result": "seam"
}
